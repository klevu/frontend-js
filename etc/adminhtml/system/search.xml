<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_include.xsd">
    <group id="developer">
        <field id="defer_js"
               translate="label comment"
               type="select"
               sortOrder="530"
               showInDefault="1"
               showInWebsite="1"
               showInStore="1">
            <label>Defer Klevu JavaScript</label>
            <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
            <config_path>klevu_frontendjs/configuration/defer_js</config_path>
            <comment>
                <![CDATA[
                    [Experimental] Applies defer attribute to Klevu JS assets and modifies Klevu initialisation
                    behaviour.
                    Please do not modify this unless you have read and understood the following guide:
                    <a href="https://help.klevu.com/support/solutions/articles/5000892040-defer-jsv2-javascript/" target="_blank">Defer JSv2 JavaScript</a><br />
                ]]>
            </comment>
            <depends>
                <field id="theme_version">v2</field>
            </depends>
        </field>
    </group>
</config>